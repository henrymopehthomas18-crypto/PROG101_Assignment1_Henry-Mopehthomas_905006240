<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="CleanFreetown_Full"/>
        <attribute name="authors" value="user"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-03 10:17:12 PM"/>
        <attribute name="created" value="dXNlcjtERVNLVE9QLUI1UzMyVlQ7MjAyNi0xMC0wMzswOTo0OTozMSBQTTsyNzg3"/>
        <attribute name="edited" value="dXNlcjtERVNLVE9QLUI1UzMyVlQ7MjAyNi0xMC0wMzsxMDoxNzoxMiBQTTs0OzI4ODQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body/>
    </function>
    <function name="validateReport" type="Boolean" variable="isValid">
        <parameters>
            <parameter name="wardName" type="String" array="False"/>
            <parameter name="fillLevel" type="Integer" array="False"/>
            <parameter name="daysSince" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="isValid" type="Boolean" array="False" size=""/>
            <assign variable="isValid" expression="true"/>
            <if expression="wardName = &quot;&quot; or fillLevel &lt; 0 or fillLevel &gt; 100  or daysSince &lt; 0">
                <then>
                    <assign variable="isValid" expression="false"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
