        <attribute name="saved" value="2026-10-03 10:33:47 PM"/>
        <attribute name="created" value="dXNlcjtERVNLVE9QLUI1UzMyVlQ7MjAyNi0xMC0wMzsxMDoyMTowNyBQTTsyNzcy"/>
        <attribute name="edited" value="dXNlcjtERVNLVE9QLUI1UzMyVlQ7MjAyNi0xMC0wMzsxMDozMzo0NyBQTTsxOzI4ODc="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body/>
    </function>
    <function name="calculatTrips" type="Integer" variable="trips">
        <parameters>
            <parameter name="totalReports" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="trips" type="Integer" array="False" size=""/>
            <assign variable="trips" expression="Floor(totalReports / 5)"/>
            <if expression="totalReports % 5 &gt; 0">
                <then>
                    <assign variable="trips" expression="trips + 1"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
